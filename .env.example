# Copy to .env and fill in one provider for model-backed demos.

# OpenAI path
OPENAI_API_KEY=
LOOPGUARD_MODEL_PROVIDER=openai
LOOPGUARD_OPENAI_MODEL=gpt-4o-mini
LOOPGUARD_EMBEDDING_PROVIDER=openai

